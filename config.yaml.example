data_dir: data/match_eval
progress_dir: .progress
focal_choice: left
ac_cutoff: [10]  # Distinct positive cutoffs; performance passes run in this order.
min_focal_region_size: [1]  # Inference sites in a merged focal region; 1 keeps all.
max_mismatches: [0]
focal_methods: [hmm, greedy]
hmm:
  recombination: 0.01
  mismatch: 1.0e-20

datasets:
  - name: out_of_africa_n300_1mbp
    zarr_path: ../tsinfer-anc-eval/data/anc_eval/zarr_vcfs/OutOfAfrica_4J17-chr20-L0-R1e6-n300-s1-rep0-geno-0.0-phase0.0-mispol0.0.zarr
    ts_path: ../tsinfer-anc-eval/data/anc_eval/simulated/OutOfAfrica_4J17-chr20-L0-R1e6-n300-s1-rep0.trees
    ancestral_state:
      field: variant_ancestral_state

  - name: tgp_chr20_n100
    zarr_path: ~/work/dphil-analysis/data/zarr_vcfs/tgp/chr20/data.zarr
    ts_path: null
    ancestral_state:
      field: variant_ancestral_allele
    # Native include and exclude are alternatives; null omits either key.
    include: 'POS >= 1000000 & POS < 11000000'
    matching_cache_size: 1024
    sample_list: data/sample_lists/tgp_chr20_n100.csv

ancestor_chunk_size: 5000
inference_threads: 1
matching_threads: 1
# Keep at least as many haplotypes in a batch as stitched matching workers.
haplotype_batch_size: 64

# Opt-in: uv run snakemake performance --cores 9
# Complete all repeats per AC/minimum pair, AC first, in configured order.
# Results: data/performance/{experiment_id}/ac{cutoff}_min{min_size}/.
# Performance trials are separate from the ordinary rule all.
performance:
  experiment_id: sample_matching_pilot
  datasets: [tgp_chr20_n100]
  modes: [resident_match, from_reference]
  methods: [full_hmm, reduced_hmm, greedy]
  worker_counts: [1, 6]
  repeats: 1  # Per AC/minimum pair; pilot first, then use a new experiment_id and 3.
  seed: 20261014
  read_workers: 1
  rss_sample_interval_s: 0.02
  trial_timeout_s: 3600
  collect_stages: true  # false gives total-only trials with workload counters.
  quality_checks: true  # Separate post-trial scientific checks, never timed.
  resident_max_matrix_mib: 512
  resident_max_rss_mib: 8192
  helper_threads:
    blosc_threads: 1
    zarr_async_concurrency: 1
    zarr_threading_max_workers: 1
    blas_threads: 1
    numba_threads: 1
