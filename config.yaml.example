# Full 1000 Genomes chr20p, all individuals; native tsinfer only.
# Within an exclusive 196-CPU, 1024-GB allocation:
# uv run snakemake native --configfile config.yaml.example --cores 196
# GRCh38 chr20 p-arm ends at 28.1 Mb (including p11.1).
# Cytobands: https://hgdownload.soe.ucsc.edu/goldenPath/hg38/database/cytoBand.txt.gz
data_dir: data/tgp_chr20p_native
progress_dir: .progress/tgp_chr20p_native
ancestor_match_freq: 0.5
focal_choice: left
ac_cutoff: 10
min_focal_region_size: 1
path_output: false
hmm:
  recombination: 0.01
  mismatch: 1.0e-20

datasets:
  - name: tgp_chr20p
    zarr_path: /well/kelleher/users/uuc395/tsinfer-snakemake/data/workflow/zarr_vcfs/chr20/data.zarr
    ts_path: null
    ancestral_state:
      field: variant_ancestral_allele
    include: 'POS < 28100000'
    # MiB: 64 GiB for the native genotype cache, within the 1-TB node.
    matching_cache_size: 65536
    # No sample_list: use every individual and both haplotypes.

ancestor_chunk_size: 5000
inference_threads: 192
matching_threads: 180
matching_read_workers: 8
sample_prefetch_chunks: 2
max_pending_haplotypes: null
temp_dir: null
helper_threads:
  blosc_threads: 1
  zarr_async_concurrency: 8
  zarr_threading_max_workers: 4
  blas_threads: 1

# Override any performance section inherited from config.yaml.
performance: null
