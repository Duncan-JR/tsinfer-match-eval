  - 1
  - 2
  repeats: 1
  seed: 20261020
  rss_sample_interval_s: 0.05
  trial_timeout_s: 300
  collect_haplotype_timings: false
  collect_stages: true
  quality_checks: true
  resident_max_matrix_mib: 512
  resident_max_private_mib: 16384
