    path: /Users/duncan/work/tsinfer-match-eval/data/greedy_smoke/inputs/tgp_chr20_n100_1mbp_populations.csv
    zarr_id_field: sample_id
    csv_id_field: sample_id
    field: population
ancestor_chunk_size: 5000
inference_threads: 2
matching_threads: 2
sample_prefetch_chunks: 1
max_pending_haplotypes: 4
temp_dir: /Users/duncan/work/tsinfer-match-eval/data/greedy_smoke/temporary
helper_threads:
  blosc_threads: 1
  zarr_async_concurrency: 1
  zarr_threading_max_workers: 1
  blas_threads: 1
performance:
