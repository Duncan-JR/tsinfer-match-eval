config_name: greedy_smoke
data_dir: /Users/duncan/work/tsinfer-match-eval/data/greedy_smoke
progress_dir: .progress/greedy_smoke
focal_choice: left
hmm:
  recombination: 0.01
  mismatch: 1.0e-20
datasets:
- name: out_of_africa_n100_1mbp
  zarr_path: /Users/duncan/work/tsinfer-match-eval/data/greedy_smoke/inputs/out_of_africa_n100_1mbp.zarr
  af_cutoff:
  - 0.03
  - 0.05
  min_region_size_kb: 0
  ancestral_state:
    field: variant_ancestral_state
  matching_cache_size: 64
  population:
    source: csv
    path: /Users/duncan/work/tsinfer-match-eval/data/greedy_smoke/inputs/out_of_africa_n100_1mbp_populations.csv
    zarr_id_field: sample_id
    csv_id_field: sample_id
    field: population
- name: tgp_chr20_n100_1mbp
  zarr_path: /Users/duncan/work/tsinfer-match-eval/data/greedy_smoke/inputs/tgp_chr20_n100_1mbp.zarr
